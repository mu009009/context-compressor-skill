{
  "version": "1.1.0",
  "description": "Context Compressor Skill v1.1.0 Configuration - Three Layer Compression Strategy",
  "last_updated": "2026-03-09",
  
  "compression_strategy": "three_layer",
  
  "emergency_compression": {
    "enabled": true,
    "trigger_threshold_percent": 100,
    "backup_enabled": true,
    "backup_dir": "/root/.openclaw/workspace/session_backups",
    "keep_recent_hours": 2,
    "summarize_before_hours": 6,
    "heartbeat_filter": {
      "enabled": true,
      "keep_latest_only": true,
      "identify_patterns": ["HEARTBEAT", "心跳", "状态检查", "系统检查"]
    }
  },
  
  "regular_compression": {
    "enabled": true,
    "trigger_threshold_percent": 70,
    "target_threshold_percent": 40,
    "progressive_summary": {
      "enabled": true,
      "time_partitions": [
        {
          "name": "recent",
          "hours": 2,
          "preservation_level": "detailed"
        },
        {
          "name": "mid",
          "hours": 6,
          "exclude_hours": 2,
          "preservation_level": "medium"
        },
        {
          "name": "old",
          "exclude_hours": 6,
          "preservation_level": "highly_summarized"
        }
      ]
    },
    "fifo_enabled": true
  },
  
  "conflict_detection": {
    "enabled": true,
    "check_interval_seconds": 180,
    "skip_if_openclaw_compressing": true,
    "log_level": "info",
    "monitor_openclaw_logs": true
  },
  
  "data_sources": {
    "priority_order": [
      "openclaw_overflow_logs",
      "session_file_stats",
      "time_based_estimate"
    ],
    "openclaw_logs": {
      "enabled": true,
      "log_path": "journalctl --user -u openclaw-gateway",
      "lookback_minutes": 60
    },
    "session_stats": {
      "enabled": true,
      "average_chars_per_message": 400,
      "max_message_count": 1000
    },
    "time_estimate": {
      "enabled": true,
      "time_based_estimates": {
        "00-03": 30000,
        "04-06": 35000,
        "07-09": 45000,
        "10-12": 55000,
        "13-16": 65000,
        "17-19": 70000,
        "20-23": 75000
      }
    }
  },
  
  "logging": {
    "enabled": true,
    "log_dir": "logs",
    "log_level": "info",
    "rotate_logs": true,
    "max_log_files": 10,
    "log_to_memory": true,
    "memory_file_path": "/root/.openclaw/workspace/memory"
  },
  
  "performance": {
    "max_compression_time_seconds": 30,
    "min_interval_between_compressions_minutes": 5,
    "enable_performance_monitoring": true,
    "alert_on_slow_compression": true
  },
  
  "integration": {
    "openclaw_integration": {
      "enabled": true,
      "monitor_heartbeat": false,
      "integrate_with_heartbeat_system": true
    },
    "memory_manager_integration": {
      "enabled": true,
      "log_to_memory_system": true,
      "update_memory_index": true
    }
  },
  
  "safety": {
    "enable_backups": true,
    "max_backup_files": 20,
    "encrypt_backups": false,
    "user_confirmation_for_emergency": false,
    "dry_run_mode": false
  }
}