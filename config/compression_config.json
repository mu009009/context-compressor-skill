{
  "version": "1.2.0",
  "description": "Context Compressor Skill v1.2.0 Configuration - Emergency Mode & Anti-Loop Protection",
  "last_updated": "2026-05-15",
  "bug_fixes": "Fixed infinite compression loop and reply truncation issues",
  
  "compression_strategy": "smart_three_layer_with_emergency",
  
  "emergency_mode": {
    "enabled": true,
    "description": "处理严重超标情况（>200%），避免无限循环",
    "threshold_percent": 200,
    "one_time_compress_to_percent": 50,
    "max_compression_attempts": 2,
    "cooldown_minutes": 15,
    "action": "deep_clean",
    "features": {
      "preserve_critical_conversations": true,
      "verify_output_integrity": true,
      "create_emergency_backup": true
    }
  },
  
  "regular_compression": {
    "enabled": true,
    "description": "常规压缩策略（70%-100%超标范围）",
    "trigger_threshold_percent": 70,
    "target_threshold_percent": 40,
    "progressive_summary": {
      "enabled": true,
      "time_partitions": [
        {
          "name": "recent",
          "hours": 2,
          "preservation_level": "detailed"
        },
        {
          "name": "mid",
          "hours": 6,
          "exclude_hours": 2,
          "preservation_level": "medium"
        },
        {
          "name": "old",
          "exclude_hours": 6,
          "preservation_level": "highly_summarized"
        }
      ]
    },
    "fifo_enabled": true
  },
  
  "anti_loop_protection": {
    "enabled": true,
    "description": "防止无限压缩循环的核心保护机制",
    "max_consecutive_compressions": 3,
    "detect_rapid_compression": true,
    "rapid_threshold_minutes": 5,
    "cooldown_after_max_attempts": 30,
    "alert_on_suspicious_loop": true,
    "features": {
      "track_compression_history": true,
      "analyze_compression_patterns": true,
      "auto_disable_on_loop_detected": false,
      "fallback_to_manual_mode": true
    }
  },
  
  "output_integrity": {
    "enabled": true,
    "description": "确保压缩后回复完整性，避免截断问题",
    "minimum_reply_length_chars": 10,
    "verify_brackets_balance": true,
    "check_sentence_completeness": true,
    "test_conversation_after_compression": true,
    "recovery_actions": {
      "restore_from_backup_on_failure": true,
      "notify_on_integrity_failure": true,
      "fallback_to_safe_mode": true
    }
  },
  
  "conflict_detection": {
    "enabled": true,
    "check_openclaw_compression": true,
    "min_interval_seconds": 600,
    "skip_if_recently_compressed": true,
    "openclaw_priority": true,
    "wait_for_openclaw_timeout": 30,
    "fallback_to_skill": true
  },
  
  "monitoring_and_logging": {
    "log_level": "INFO",
    "enable_real_time_monitoring": true,
    "check_interval_seconds": 300,
    "alert_on_warning": true,
    "emergency_alert_threshold_percent": 150,
    "log_compression_attempts": true,
    "analyze_compression_efficiency": true
  },
  
  "integration": {
    "with_openclaw": true,
    "with_memory_manager": true,
    "with_smart_reminder": true,
    "with_heartbeat_system": true,
    "integration_mode": "cooperative"
  },
  
  "backup_and_recovery": {
    "enabled": true,
    "backup_before_compression": true,
    "keep_recent_backups": 3,
    "backup_retention_hours": 24,
    "emergency_restore_enabled": true,
    "auto_restore_on_failure": false
  },
  
  "performance_optimization": {
    "batch_processing_size": 1000,
    "max_processing_time_seconds": 30,
    "memory_limit_mb": 512,
    "cpu_usage_limit_percent": 50
  },
  
  "safety_limits": {
    "max_context_chars": 98304,
    "absolute_max_chars_before_emergency": 196608,
    "min_context_chars_after_compression": 10000,
    "max_compression_ratio": 0.9
  },
  
  "debug_and_testing": {
    "enable_debug_mode": false,
    "log_verbose_details": false,
    "test_mode": false,
    "simulate_high_context": false,
    "validate_configuration": true
  }
}